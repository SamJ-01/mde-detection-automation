// =============================================================================
// Custom detection : LSASS memory dump with built-in or common tools
// ATT&CK           : T1003.001 OS Credential Dumping: LSASS Memory (Credential Access)
// Tables           : DeviceProcessEvents
// Severity         : High
// Automated action : Isolate device (full) + Collect investigation package
// Frequency        : Every hour
// Scope            : Lab exercise against synthetic data.
// -----------------------------------------------------------------------------
// Why it matters   : Dumping LSASS exposes credentials for every account logged on
//                    to the host; it is usually the step before lateral movement.
// False positives  : Approved troubleshooting dumps (procdump) by support staff.
//                    These should be pre-approved and excluded by account.
// =============================================================================
DeviceProcessEvents
| where Timestamp > ago(1h)
| where ((FileName in~ ("procdump.exe", "procdump64.exe") or ProcessVersionInfoOriginalFileName =~ "procdump")
          and ProcessCommandLine has "lsass")
     or (FileName =~ "rundll32.exe" and ProcessCommandLine has "comsvcs" and ProcessCommandLine has "minidump")
     or ProcessCommandLine has_any ("sekurlsa", "lsadump")
| project Timestamp, DeviceId, ReportId, DeviceName, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName
